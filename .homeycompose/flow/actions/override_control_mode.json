{
  "id": "override_control_mode",
  "title": {
    "en": "Override control mode on"
  },
  "titleFormatted": {
    "en": "Override control mode ON for [[profile_id]] for [[duration]] [[duration_unit]]"
  },
  "hint": {
    "en": "Forces the selected profile ON for the selected duration. Select indefinite to ignore the duration value and keep the override until it is cleared."
  },
  "args": [
    {
      "type": "autocomplete",
      "name": "profile_id",
      "title": {
        "en": "Boiler profile"
      }
    },
    {
      "type": "number",
      "name": "duration",
      "min": 0,
      "title": {
        "en": "Duration"
      },
      "placeholder": {
        "en": "0"
      }
    },
    {
      "type": "dropdown",
      "name": "duration_unit",
      "title": {
        "en": "Unit"
      },
      "values": [
        {
          "id": "seconds",
          "label": {
            "en": "seconds"
          }
        },
        {
          "id": "minutes",
          "label": {
            "en": "minutes"
          }
        },
        {
          "id": "hours",
          "label": {
            "en": "hours"
          }
        },
        {
          "id": "indefinite",
          "label": {
            "en": "indefinite"
          }
        }
      ]
    }
  ],
  "tokens": [
    {
      "name": "should_heat",
      "type": "boolean",
      "title": {
        "en": "Should heat now"
      }
    }
  ]
}
